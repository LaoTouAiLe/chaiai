# local-agent-web 配置示例
#
# 复制为 config.yaml 再按需修改；config.yaml 已被 .gitignore 排除，不会提交。
# API Key 不写在这里：这里只写“存放 Key 的环境变量名”，Key 的值放在 .env。
# 默认配置对接 DeepSeek；换成其他 OpenAI 兼容端点只需改 llm.base_url 与 llm.model。

# 所有应用数据的根目录（2026-10-26）。
# 空串 = 平台标准目录：Windows 是 %LOCALAPPDATA%\chaiai，macOS 是
# ~/Library/Application Support/chaiai，其它平台是 $XDG_DATA_HOME/chaiai 或 ~/.local/share/chaiai。
# 只接受**绝对路径**（`~` 会展开）：相对路径会随启动目录漂移，正是这个字段要消灭的东西。
# 也可以设环境变量 CHAIAI_HOME 覆盖它——环境变量在读配置之前生效，设置库打不开时仍然有路。
# 换根之后旧数据**不会自动搬过去**：启动横幅会打印新根与检测到的旧数据位置，搬不搬由你决定。
# 下面所有 path 都相对这个根；写绝对路径则原样使用。
data_root: ""

llm:
  provider: openai_compatible
  base_url: "https://api.deepseek.com"
  api_key_env: "DEEPSEEK_API_KEY"
  model: "deepseek-flash"          # 该 key 实测可用：deepseek-flash、deepseek-v4-pro
  # 必填：模型的上下文窗口（token），必须按所连模型的实际窗口填写——压缩触发比
  # memory.compression.trigger_ratio 以“窗口 − max_tokens”为分母，填错会让压缩过早或过晚触发。
  # 示例值必须与上面 `model` 对得上（2026-10-01 修正）：`deepseek-flash` 是 DeepSeek-V4-Flash，
  # 窗口 **1M**，触发点 = 0.8×(1048576−4096) = 835,584 token；填成 65536 会让触发点掉到
  # 49,152 token——长会话被过早摘要、窗口被过早重写，既丢原文又断前缀缓存。
  context_window_tokens: 1048576   # 示例值：对应 deepseek-flash 的 1M 窗口
  temperature: 0.2
  max_tokens: 4096                 # 输出预留：输入 Prompt 的可用预算 = 上下文窗口 − 这个值
  timeout_seconds: 120
  retry_count: 2
  # 网页是否按增量流式展示**最终回答**（T23）。默认关闭：流式只是展示层优化——只影响
  # "最终回答"那两个调用点的显示，planner/反思/工具调用/工具结果/隐藏推理都不流式；
  # 流式过程不逐块写 Checkpoint，模型不支持或中途失败都会退化为一次普通完整调用。
  streaming: false

embedding:
  # 示例保持关闭：加载示例配置不会导入 fastembed、不访问网络、不下载模型。
  # 打开前先确认 cache_dir 是本机可写目录；模型权重只落那里，不进 Git、不进源码目录。
  enabled: false
  provider: "onnx_local"           # onnx_local（本地 ONNX，默认）| openai_compatible
  model: "BAAI/bge-small-zh-v1.5"  # onnx_local 用 FastEmbed 模型名；openai_compatible 用 API 模型名
  # onnx_local 必填：**本机可写绝对路径**。示例故意留空——模板里写一个别人的盘符（原来写的
  # 是开发机的盘符）会让朋友照抄到自己的机器上，然后困惑"为什么下不动模型"。
  # 打开 embedding 之前把它换成你自己的目录，例如 Windows 的 `C:/Users/你/.chaiai/models`
  # 或 POSIX 的 `/home/你/.chaiai/models`。
  cache_dir: ""
  local_files_only: false          # true：禁止下载，只从 cache_dir 加载（缺模型即失败）
  # 改用 OpenAI 兼容 Embedding API 时，把上面四行换成下面三行（provider 决定可用字段）：
  # provider: "openai_compatible"
  # base_url: "https://api.example.com/v1"
  # api_key_env: "EMBEDDING_API_KEY"

workspace:
  root: "."
  # 权限档位（2026-10-15 起换成"能写到哪"的三档，**出厂默认 workspace-write**）：
  # 三档均允许显式本机外部绝对路径的读取、列目录与搜索；敏感文件仍受限。
  #   read-only          = 工作区只读：新建/修改/删除文件一律拒绝；命令经无写授权令牌运行（Windows）
  #   workspace-write    = 工作区可写；外部写只允许「设置 → 权限」里添加的可写目录
  #   danger-full-access = 工作区可写；工作区外一律可读，**写仍只按逐条授权**
  # 界面上的档位存在设置库里（改完下一轮生效），这里只是新安装与旧配置的起点。
  # 旧值自动归一：deny / whitelist → workspace-write，allow → danger-full-access。
  external_paths:
    mode: "workspace-write"
  # 旧键（T14C）：true 归一为 danger-full-access（旧写法 allow）。只作快捷方式；
  # 用了它就**不要再**在 external_paths 里另写档位——两个键同时出现会被判成语义冲突。
  allow_external_paths: false
  max_file_size_bytes: 2000000

agents:
  enabled: true
  filenames:
    - "AGENTS.md"
    - "AGENTS.override.md"
  max_file_chars: 20000
  max_total_chars: 60000
  precedence:
    closer_directory_wins: true
    override_wins: true

memory:
  short_term:
    enabled: true
    backend: "sqlite_checkpoint"
    path: "checkpoints.sqlite"     # 相对 data_root（2026-10-26 起不再写 data/ 前缀）
    preserve_checkpoint_messages: true
    prompt_window_messages: 100

  medium_term:
    enabled: false                 # v0.1a / v0.1b 保持关闭，节点透传
    backend: "chroma"
    path: "chroma"                 # 相对 data_root
    collection: "agent_memory"
    top_k: 8
    # 召回的最低语义相似度（真实余弦）。0.53 按默认模型 bge-small-zh-v1.5 实测标定：
    # 相关 0.560~0.772、无关 0.242~0.497（该模型相关性基线偏高）；换模型要重新标定。
    min_score: 0.53
    decay_half_life_days: 30
    write_on:
      - "task_completed"
      - "important_fact_changed"
      - "explicit_user_preference"

  long_term:
    enabled: true                  # 默认启用本地 SQLite 长期记忆；不依赖 Embedding 或网络
    backend: "sqlite"
    path: "memories.sqlite"        # 相对 data_root
    confidence_threshold: 0.75
    importance_threshold: 0.5
    aging_enabled: true
    forget_after_days: 180
    # 是否允许把事实写进**用户级**（跨项目可见）作用域。默认 false：entity_fact 一律落项目级。
    # 判定"这是个人偏好而不是项目事实"依赖模型输出的 entity_type，而作用域是跨项目隔离边界，
    # 一次误分类就会让项目事实被别的项目召回——所以跨项目共享必须显式打开。
    allow_user_scope: false

  compression:
    enabled: true                  # 默认启用 Prompt 窗口压缩；Checkpoint 原始 messages 不删
    trigger_ratio: 0.8
    preserve_recent_turns: 8
    # 保留下限的**窗口比例**：实际保留轮数 = preserve_recent_turns 之内、且 token 总量不超过
    # retain_ratio × context_window_tokens 的**最近**轮数（下限 1 轮）。窗口大时按
    # preserve_recent_turns 走（行为不变）；窗口小时自动收紧，避免"保留下限大于窗口"导致压缩
    # 触发也压不动。必须小于 trigger_ratio（配置校验会拦截）。
    retain_ratio: 0.16
    # 窗口里「工具步内容」的字符预算：从最新一步往回累计，超预算的**更早**步骤才整步省略。
    # 短循环因此一个字都不省 → 历史保持追加式 → 供应商的前缀缓存可复用（成本相关，别随手调小：
    # 只按条数省略会让窗口每步重写中段，实测把缓存命中率从可用的七成打到 19.9%）。
    # 这是**安全网**，不是日常裁剪手段：触发一次就断一次前缀缓存，重新付满整窗（实测一次约多花
    # 9 万未命中 token，缓存读从 48,512 塌到 3,456）。**必须留足余量**——卡在临界点时触发与否由
    # "模型这次多读了几份文件"随机决定，而代价极高（2026-10-01 由 120000 提到 160000）。
    # 注意这是**字符**预算、不是 token 预算：中文内容按字符折算会大得多。
    tool_step_budget_chars: 160000
    preserve_recent_tool_steps: 3  # 下限：预算再紧也至少保留这么多最近完整工具步
    # 单条工具结果的字符阈值：超过就压成「头 + 中段标记 + 尾」，0 表示不压。
    # 按**单条结果**判定（不是等窗口超预算）：结果在被发出去之前就压好了，因此不破坏前缀缓存。
    tool_result_keep_chars: 8192   # 压力达标后单条正文裁剪阈值；0 禁止正文裁剪
    summary_max_chars: 12000

security:
  # 工作区文件操作默认免审批；破坏性 Shell 分类仍需审批。
  require_approval:
    delete_file: false
    destructive_shell: true
    large_batch_edit: false
    overwrite_existing_file: false

  large_edit:
    # 大范围编辑的免审额度：**一轮内可改几个文件**（2026-10-15 生效口径）。
    # 仅 require_approval.large_batch_edit=true 时启用；默认关闭，新建文件不计。
    max_files_without_approval: 3
    # 已不参与判定（保留字段只为旧配置不报错）：2026-10-15 起不再按改动行数判——
    # 那个量级恰好是"重写一个函数"的常态，实证里把正常重构变成了逐次弹卡。
    max_changed_lines_without_approval: 200

  shell:
    platform: "auto"
    # 已不参与判定（保留字段只为旧配置不报错）：2026-10-15 起写侧沙箱不是独立开关，
    # 各档位在 Windows 上均约束写入；read-only 不授予写权限，
    # 其余档位的可写根为工作区、专属临时目录、显式读写授权目录；
    # 凭据子目录受保护；根上一条可继承 ACE，新目录立即继承可写。读侧/网络不隔离，
    # Everyone/登录 SID 的已有写权限、硬链接和并发改名仍有边界；各机器兼容性需实际验证。
    # 非 Windows 照常运行，只是没有 OS 级写边界（不再失败闭合）。
    sandbox: false
    # 执行器偏好（架构 §6.6）：
    #   argv_preferred = 能 argv 就 argv；命令含 Shell 语法时用平台默认适配器
    #                    （Windows→cmd.exe /d /s /c、POSIX→/bin/sh -c）
    #   cmd / pwsh / sh = 显式指定 Shell 语法命令交给哪个适配器执行；
    #                     适配器与运行平台不匹配时直接拒绝（失败闭合）
    executor: "argv_preferred"
    default_timeout_seconds: null
    # 单条命令的**超时上限**（秒）。**默认不设上限**（`null`）：慢命令（冷启动浏览器、装依赖、
    # 真实构建）由模型按需传更大的 `timeout_seconds`，不再被一个隐含的 60 秒天花板拦下。
    # 需要收紧的部署写个数字即可（例如 300）；任务的**总时长**另有 `jobs.max_task_seconds` 管。
    max_timeout_seconds: null
    max_output_chars: 30000
    # **已不参与放行判定**（2026-10-15）：命令的审批只由"破坏性 / 提权"触发，
    # 档位与沙箱负责边界；这张表仍会被解析并用于命令分类与审计文案，但改它不会让某条命令
    # 变得要审批或免审批。保留字段只为旧配置不报错。
    # 白名单按 平台 + 可执行名（归一化大小写与 .exe/.cmd 后缀）+ 参数结构 + 可选 cwd 匹配。
    # match: exact  = 参数必须完全一致（默认）：pytest 带任意测试参数、git diff 带额外参数都不会免审。
    # match: prefix = 条目参数是实际参数的**前缀**，允许后面跟任意参数：
    #                 例如 args: ["run", "build"] 能命中 `npm run build -- --watch`。
    #                 prefix 只用在"参数怎么变都不改变副作用范围"的命令上；**解释器类不要用**
    #                 （`python -c "…"` 的后续参数就是任意代码）。prefix 至少要写一个参数——
    #                 空参数前缀等于把整个可执行文件放行，配置校验会直接拒绝。
    # 不写 cwd 表示不限目录；写了则只在那个工作目录（相对 workspace.root）下免审。
    whitelist:
      - platform: ["windows", "posix"]
        executable: "python"
        args: ["--version"]
        match: "exact"
      - platform: ["windows", "posix"]
        executable: "pytest"
        args: ["--version"]
        match: "exact"
      - platform: ["windows", "posix"]
        executable: "git"
        args: ["status"]
        match: "exact"
      - platform: ["windows", "posix"]
        executable: "npm"
        args: ["run", "build"]
        match: "prefix"   # `npm run build -- --watch` 这类带额外参数的调用也免审
      - platform: ["windows", "posix"]
        executable: "git"
        args: ["diff"]
        match: "exact"
      - platform: ["windows", "posix"]
        executable: "ruff"
        args: ["check"]
        match: "exact"
    blocked_patterns:
      - "rm -rf"
      - "del /s"
      - "format "
      - "shutdown"
      - "chmod"
    # curl/wget 下载不自动归为破坏性命令；写入边界仍由权限档位与沙箱执行。

  secrets:
    redact_environment_values: true
    block_known_secret_files: true

# 按需代码检索（T21）：不建持久索引，每次查询直接读当前工作区。
# enabled=false 时不访问文件系统、不探测 rg、不加载解析器（纯透传，无副作用）。
#
# **2026-10-01 默认由 false 改为 true**：关闭时工具集里没有任何定位代码的手段（只有
# list_dir / read_file / edit_file / write_file / delete_file / run_shell），实测一个"梳理架构"
# 的请求在 14 次 list_dir 之后用尽循环预算——既烧钱又没做完，而且计划里写出"先用 grep 搜索定位"
# 这种本机并不存在的工具（模型在描述自己没有的能力）。打开后注入带路径与行号的片段，模型据此
# 定向读取。这一条对"回答质量"的影响大于对成本的影响。
rag:
  enabled: true
  max_results: 8
  timeout_seconds: 10
  # 候选发现最多检查的文件数：达到上限即停止，并在结果说明里标注"已截断"。
  # **必须大于工作区文件数**，否则检索存在**系统性盲区**（只看得到遍历顺序靠前的那一部分，
  # 而不是随机采样）。实测：599 个文件的工作区在 200 时会漏掉 routers.py / config.py 这类
  # 核心文件；提到 2000 后召回正常，Python 退化扫描耗时 0.66s（上限 timeout_seconds=10）。
  max_files: 2000
  max_file_bytes: 262144
  max_terms: 4
  max_matches_per_term: 20
  context_lines: 20
  snippet_chars: 1200
  section_chars: 4000

agent:
  max_tool_loops: null
  max_retries_per_step: 2
  require_evidence_for_completion: false

# Agent 能力档位（v0.5 T50，契约 §16.1；2026-10-13 起**只给出厂默认**）。
#
# 现在决定"模型能看见哪些工具"的是**页面上的逐能力开关**（「能力」面板，存在设置库里，改完下一轮生效、
# 不用重启服务）。这一节只决定**出厂默认开关表**：用户没在页面改过任何开关时，就用它算出来的那一组。
# 页面改过的项以设置库为准，**不会被这里覆盖**；要回到出厂默认就再点一次开关。
#
# 出厂默认的合成规则：五个基础能力（plan / files_read / code_search / files_write / shell）取自
# `active` 声明的那一档；git_read / git_write / skill 取下面各段开关**与**档位声明的交集——
# 与 v0.5 的"档位 ∩ 配置开关"逐项等价，所以一份没改过的配置上升级前后行为一致。
# **联网（web）恒定打开**（2026-10-14 起常态能力，见下），不受档位与开关影响。
#
# 内置三档（名字固定）：coder（v0.4 工具集 + 联网 + Git 读写，默认）| researcher（只读 + 计划 + 联网 + Git 只读）|
# reviewer（只读 + 联网）。新增能力一律**追加在末尾**：前面的字节不变，前缀缓存的前半段仍可复用。
# custom 用于不改代码地定义自己的组合；不能覆盖内置名，能力名必须是架构 §6.9 闭集里的，
# 写错会在启动时失败并列出可选项（不静默退回默认档）。
#
# 三个能力**不可关闭**（files_read / code_search / web）：前两个是闲聊与两类工作流的硬依赖，
# web 是**常态能力**——"问一句简单的事只能拿训练数据答"不算能用的助手。想开"只读会话"，
# 就在页面上关掉「修改工作区文件」与「执行命令」。
profiles:
  active: "coder"
  custom: {}
  # custom:
  #   docs: ["files_read", "code_search"]

# 外部访问（v0.5 T53，契约 §16.3）。**2026-10-14 起联网是常态能力**：出厂即开、且不可关闭
# （"问一句简单的事，模型只能凭训练数据答"不算能用的助手）。因此 `enabled` 这个键**已退出决策链**——
# 它只剩"运行期由服务回灌"这一个身份，写 false 也关不掉联网；键保留是为了旧配置能原样加载。
# 想真正关掉联网，目前要在代码里同时放开 `capabilities.LOCKED_CAPABILITIES` 与
# `AppConfig.capability_default_layer` 里那一行（两处必须一起动）。
# 安全边界（§6.10）不靠这道开关，而靠：只允许 http/https、拒绝本机与内网地址、**重定向后再次校验**
# （防 SSRF）；外部内容按不可信数据处理；结果有界并如实说明截断。
web_access:
  enabled: true
  # auto：配置搜索密钥时用 Tavily，否则用 Bing HTML 兼容搜索；故障不隐式切换收费服务。
  # 可显式选择 tavily / deepseek / bing_html / duckduckgo_html。HTML 兼容搜索不支持精确时间筛选。
  # deepseek（2026-10-26）按次计费（每 1000 次成功请求 5 元，失败与无结果不计费）：
  # 它**不参与 auto 的判定**（否则刚录一条密钥就会悄悄改掉已有用户的后端），要显式选；
  # 选了却没有密钥时如实失败，不静默换后端。
  provider: "auto"
  tavily_api_key_env: "TAVILY_API_KEY"
  # DeepSeek 搜索的旧环境变量路径：设置页没录入专用密钥时才读它。
  # 变量名可以与模型连接共用一个（同一个 API Key 两端都能用）。
  deepseek_api_key_env: "DEEPSEEK_API_KEY"
  # 正文从哪来（2026-10-26），与 provider 分开——搜索和抓取可以各选一个：
  #   local    本机直接取回并抽取（默认，与加这个开关之前完全一致）
  #   deepseek 交给 POST /v1/tools/fetch，由对方返回 Markdown；URL 会发出去、按次计费，
  #            且最终地址与内容类型不在本机校验。失败如实报错，不回退本机抓取。
  # 搜索后的摘要预抓取（prefetch_pages）始终走本机，不受此项影响。
  fetch_provider: "local"
  # 每轮硬上限；失败也消耗尝试次数，刷新和恢复不会重置。足够回答时应提前结束。
  max_search_calls: null
  max_read_pages: null
  max_reads_per_page: null
  timeout_seconds: 15
  max_results: 5
  max_chars: 8000
  user_agent: "chaiai/0.5 (local agent)"

# Git 能力（v0.5 T54，契约 §16.4、工具定义 §6.11）。**默认关闭**：打开它等于让 Agent 能读仓库历史
# （以及经审批后提交），应当是显式决定；关闭时 git_read / git_write 完全不可见（工具不绑定、提示也不提）。
# 同样只是**出厂默认**：页面上可以分别打开「查看 Git 状态与差异」与「提交到 Git」，改完不用重启服务。
# 本机找不到 git 可执行文件时同样不可见（能力不进有效集合），此时工具会如实说明"缺什么、怎么装"。
# 边界：作用域是**工作区**（仓库在上一层时结果只覆盖工作区）；参数是闭集，任何路径都不出现 push；
# 提交必须人工审批，main/master 上还要额外确认；只 add 显式列出的路径（不支持 git add -A）。
git:
  enabled: false
  timeout_seconds: 20
  max_output_chars: 20000

# 技能（v0.5 T55，契约 §16.5、工具定义 §6.12）。把"指令"从"每轮都发"变成"按需加载"：
# 清单（只有名字与描述）随运行时快照发给模型，正文由 skill_load 按需取——两者都不进稳定前缀，
# 所以关掉它时前缀与快照逐字节不变。**默认关闭**，关闭时 skill 能力完全不可见。
# 发现顺序（rank 由小到大，同名先到者赢）见 §16.5；下面两个开关控制"读哪些根"：
#   - include_user_skills：读默认的个人级根（~/.agents/skills、~/.codex/skills（跳过 .system）、
#     以及本机已装的厂商目录）。这些被当成**用户自己的**内容（来源 owner）。
#   - user_dirs：追加根，**只接受绝对路径**（`~` 不展开）。市场缓存目录（例如
#     `~/.codebuddy/skills-marketplace/skills`，实测一处 295 个技能）**默认不读**——
#     全列出来约 6 万字符，一份就吃光 agents.max_total_chars；要读请显式写在这里。
# 本轮**不读工作区内的项目级技能**（仓库可能是别人给的），见 §16.5 的"明确不做"。
skills:
  enabled: false
  include_user_skills: true
  # 相对路径按**本文件所在目录**展开（2026-10-16）：包里的 `skills/` 因此"解压到哪个盘都能用"，
  # 不需要让使用者手改绝对路径。绝对路径照旧可用；`~` 仍然拒绝（§16.5）。
  user_dirs: ["skills"]
  max_skill_chars: 20000
  max_list_chars: 8000

# MCP 客户端（2026-10-20，架构 §6.13）。**默认关闭**：关闭时不连任何 server、mcp 能力不出现，
# 行为与接入前逐字节一致。
#
# 这里**只有运行参数，没有 server 列表**：server 的连接方式写在同目录的 `mcp.json`（顶层 mcpServers，
# 与 CodeBuddy 同格式，可以整份粘过来），server 的开关与工具白/黑名单是**用户状态**、存设置库。
# 三份东西分开的理由：部署配置、用户状态、运行参数的生命周期不同，混在一起升级时会互相牵连。
#
# 规模口径（四个不等于）：配置 N 个 ≠ 连 N 个；连 N 个 ≠ 给模型 N×K 个；给模型 N×K 个 ≠ 每轮都发；
# 每轮都发 ≠ 全量进提示。落到参数上就是下面的 max_connected_servers / max_direct_tools /
# max_tool_schema_bytes 三道闸，其余工具走检索（mcp_tool_search）。
mcp:
  enabled: false
  # 直接绑定给模型的工具上限；其余进检索。0 表示全部走检索（工具很多时可这么设）。
  max_direct_tools: 20
  # 同时在连的 server 数。50 个 npx+node 常驻会吃掉数 GB 内存，必须排队。
  max_connected_servers: 4
  # 空闲多久断开子进程（秒）。0 = 不回收，只在内存充裕的机器上这么设。
  idle_timeout_seconds: 600
  # 启动（握手）超时：`npx -y` 首次要下载包，给足 30 秒。
  startup_timeout_seconds: 30
  # 单次 tools/call 超时；超时按失败如实报告，不重试。
  call_timeout_seconds: 60
  # 单条工具定义（描述 + 参数 schema）的字节上限，超限的工具不可见。
  max_tool_schema_bytes: 8192
  # 单次检索返回的条数。
  max_search_results: 8

# ---- 后台任务与长时间运行（v0.6，架构 §17.2）--------------------------------
# 这里**不是能力开关**：它不是"关掉就不可用"，而是"这一轮在哪里跑"。
#   background: false（默认）＝ 本次执行在提交请求内跑到终态，与 v0.5 逐字节一致；
#               true          ＝ 先登记任务并立即返回（status="running" + job_id），
#                               由本机 worker 在后台跑到终态或"等待用户"。
# 两种取值下图节点调用序列与事件序列逐项一致，唯一差异是"POST 返回时任务是否已终态"。
# 结局由任务索引（与会话索引、Checkpoint 同库）+ Checkpoint 快照给出，不靠 SSE。
# max_concurrent_jobs：后台 worker 并发上限；本机单用户、单进程默认 1。
# 每会话单飞不变：同一会话的第二个提交仍然返回 SESSION_BUSY（不排队）。
jobs:
  background: false
  max_concurrent_jobs: 1

# v0.4 独立 Web 前端与 HTTP API（T29，契约 §15.3）。
# 默认只绑定回环地址：v0.4 没有鉴权，改 host 必须同时打开 allow_non_loopback，
# 否则启动校验直接拒绝（不允许"改了就暴露到公网"这种静默升级）。
web:
  host: "127.0.0.1"
  port: 8000
  allow_non_loopback: false
  # 允许的 Host 头（防 DNS rebinding）；非回环部署时把域名写进来。
  allowed_hosts:
    - "127.0.0.1"
    - "localhost"
    - "[::1]"
  # 开发期跨源：只允许 Vite dev server；生产同源（由本服务托管前端产物）。
  dev_origins:
    - "http://127.0.0.1:5173"
    - "http://localhost:5173"
  # 请求体上限；超限 413，不进入业务逻辑。
  # 别调到 1 MB 以下：聊天里上传图片走 base64 的 JSON（4 MB 的图约 5.3 MB），低于这个就传不了图。
  max_body_bytes: 8000000
  static_dir: "frontend/dist"      # 相对配置文件所在目录；不存在时只提供 API
  sse_heartbeat_seconds: 15        # SSE 心跳间隔：死连接不能一直占着订阅
  sse_idle_timeout_seconds: 300    # SSE 空闲上限：超过则关闭该连接（不取消任务）
  sse_max_pending_events: 200      # 单次排空超过它就判定客户端落后：结束订阅并要求重连
  keepalive_seconds: 15            # HTTP keep-alive 超时（uvicorn timeout_keep_alive）

# 确定性工作流（v0.7 T65–T67，架构 §18.2/§18.3/§18.5）与自主委派（§18.7）。
#
# 这一段同时是**自主委派**的资源上限（`max_children` / `max_concurrency` / `child_timeout_seconds` 等）：
# 那个能力由页面上的「自主委派调查」开关控制（默认关），**不**受下面的 `enabled` 影响——`enabled` 只管
# 显式图入口（脚本与评测跑器用 `POST .../messages` 的 `workflow` 字段发起的那条路）。
# 打开自主委派 = 允许主 Agent 自己决定派只读子 Agent，每个子任务会多花一次模型调用。
#
# 2026-10-13 起**页面不再提供入口**：三类工作流（只读调查 / 代码修改与验证 / 委派只读调查）从输入区撤下，
# 它们是离线编排与评测用的工程资产，不面向日常使用。撤下的是界面，不是能力——`POST .../messages` 的可选
# `workflow` 字段、请求契约与审批/快照投影都不变，脚本与评测跑器照旧可用。
# 只读的工作流状态投影保留：通过 API 发起的工作流仍会在页面上如实呈现阶段、计数与失败原因。
workflows:
  enabled: false                  # 关掉时工作流请求一律失败并说明"未启用"，不静默改跑自由循环
  max_tool_calls: 256
  max_steps: 512
  max_source_files: 128
  max_evidence_chars: 256000
  max_report_chars: 256000
  max_model_tokens: 1048576 # T66 模型调用前的保守总预留，不是供应商实际量
  max_model_output_tokens: 16384
  max_children: 8 # T67 共用上述总额度，预先均分；不能再次委派
  max_concurrency: 4 # 输入默认串行，仅显式允许只读并发
  child_timeout_seconds: 900

# 可视化模型连接设置（T29A，契约 §6.8；2026-10-13 起密钥也落这里）。
# 设置（连接、默认与会话选择、能力检测结果、能力开关）存在这个**独立**库里。
# 密钥存在同一库的 settings_meta（键 credentials.<引用>）——**明文**：
# 代价是把设置库连同密钥一起备份/导出/发给别人等于交出密钥；
# 收益是"保存即持久、重启仍在"在**所有**机器上行为一致（此前依赖 Windows 凭据管理器，
# 分发形态下它会在别人的机器上因服务或策略失败，表现为"重启后密钥没了"，用户无从判断）。
# 密钥仍然**不进**任何 DTO、日志、错误消息、导出与截图（脱敏照旧生效）。
# 已有 config.yaml 时，首次启动会把上面的 llm 段**幂等导入**成一条默认连接，之后以页面为准。
model_settings:
  path: "model_settings.sqlite"     # 相对 data_root（2026-10-26）
  credential_store: "auto"         # auto（默认：密钥存本库 settings_meta）| memory（只在进程内，重启需重录）
